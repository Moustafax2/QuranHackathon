# Copy this file to .env.local and fill in the credentials from your Quran Foundation email.

# Use "prelive" for hackathon/test credentials unless Quran Foundation told you to use production.
QF_ENV=production

QF_CLIENT_ID=
QF_CLIENT_SECRET=
QF_SESSION_SECRET=

# App base URL used to build OAuth callback/logout redirects.
# Production should stay aligned with the registered callback:
# https://quran-hackathon.vercel.app/api/auth/callback
APP_URL=http://localhost:3000

# Optional override for Quran Foundation user API base URL.
# QF_USER_API_BASE_URL=https://apis-prelive.quran.foundation

# Optional override for requested Quran Foundation OAuth scopes.
# Default is: openid offline_access bookmark user
# QF_USER_SCOPES=openid offline_access bookmark user

# Optional provider logout redirect URL.
# Only set this if Quran Foundation has whitelisted it as a post_logout_redirect_uri.
# QF_POST_LOGOUT_REDIRECT_URI=https://quran-hackathon.vercel.app

# Optional: enable local fake-login helpers outside production.
# ENABLE_DEV_AUTH=true

# Optional overrides. Leave these commented out to use the official defaults foonr QF_ENV.
# QF_AUTH_BASE_URL=https://prelive-oauth2.quran.foundati
# QF_API_BASE_URL=https://apis-prelive.quran.foundation

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
